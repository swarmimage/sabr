# Скопируй в .env.local и подставь значения. Без MONGODB_URI приложение работает только локально, без аккаунтов.
MONGODB_URI=mongodb://127.0.0.1:27017/sabr

# Публичный адрес сайта: используется в ссылке восстановления пароля.
APP_URL=http://localhost:3000

# Ключ Claude API для разговора в SOS и разбора недели. Без него ИИ-функции скрыты.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Почта для восстановления пароля (nodemailer, SMTP). Без SMTP_HOST письма не отправляются.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sabr <no-reply@example.com>"
